# -----------------------------------------------------------------------------
# Ollama / LLM (already running natively — https://ollama.com)
# -----------------------------------------------------------------------------
OLLAMA_MODEL=llama3:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MAX_RETRIES=
OLLAMA_TEMPERATURE=
# RAG answer generation (generate node, cv-ask --generate); router/rewrite use 0.0
OLLAMA_ANSWER_TEMPERATURE=

# -----------------------------------------------------------------------------
# Qdrant (vector store for RAG; use after docker compose up -d qdrant)
# -----------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=cv_chunks

# Retrieval models (fastembed)
RAG_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RAG_RETRIEVAL_TOP_K=12
RAG_RERANK_TOP_K=3

# -----------------------------------------------------------------------------
# CV corpus (PDFs) and RAG artifacts
# -----------------------------------------------------------------------------
CV_OUTPUT_DIR=data/cvs
RAG_CLEAN_TEXT_DIR=artifacts/rag/clean_text
RAG_CHUNKS_DIR=artifacts/rag/chunks

# -----------------------------------------------------------------------------
# Hugging Face / photo generation
# -----------------------------------------------------------------------------
HF_TOKEN=
HF_PHOTO_MODEL_ID=black-forest-labs/FLUX.1-schnell
HF_PHOTO_ENABLED=true
HF_PHOTO_FAIL_ON_ERROR=false
HF_PHOTO_TIMEOUT_SECONDS=60
HF_PHOTO_CACHE_DIR=.cache/photos

# -----------------------------------------------------------------------------
# Chainlit debug
# -----------------------------------------------------------------------------
# Show routing/rewrite/sources after each answer in the Chainlit UI
RAG_CHAINLIT_VERBOSE=false
